# Docsy — copy to .env.local and fill in. Never commit real values.

# ---- Supabase API ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---- Postgres ----
# Percent-encode any reserved characters in the password (# -> %23, @ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Configuration store ----
# Required before any secret (a Paystack key, an SMTP password) can be saved from
# Settings → Integrations. Secrets are encrypted with this key before they are
# written, and it is never stored in the database — so reaching Postgres alone
# yields ciphertext. Without it, secrets can only come from the environment.
#
# Generate one:  openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# Everything below can now be set in Settings → Integrations instead. Values here
# take precedence, which means write access to the database cannot redirect
# payments or mail.

# ---- Payments (Paystack) ----
# Settles KES to a Kenyan bank account and accepts M-Pesa, cards and bank
# transfer, plus international cards — one integration for both audiences.
# Use sk_test_/pk_test_ keys until you are ready to take real money.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
#
# Then, in the Paystack dashboard, set the webhook URL to:
#   https://your-domain/api/webhooks/paystack
# Without it a buyer who closes the tab after paying is never delivered to.
# The endpoint verifies Paystack's signature and rejects anything unsigned.

# ---- Email ----
# EMAIL_FROM is required either way. Use an address on a domain you control, and
# add SPF, DKIM and DMARC records for it — that, not the transport, is what
# decides whether mail lands quickly or sits in a spam queue.
EMAIL_FROM=Docsy <hello@yourdomain.com>

# Blind-copied on every receipt and delivery email, so you keep a record of each
# sale. Campaigns are never copied — a 200-person send would put 200 copies in
# your inbox. Leave blank for no copies.
EMAIL_COPY_TO=

# Option A: your own SMTP server or hosting account. Preferred when set.
# SMTP_PORT defaults to 587. Use 465 only with implicit TLS; SMTP_SECURE is
# inferred from the port and rarely needs setting by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false

# Option B: Resend's HTTP API. Used only when SMTP_HOST is absent.
RESEND_API_KEY=

# Check whichever is configured:  npm run mail:test -- you@example.com
